{
  "name": "nds-lucid-web-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write \"src/**/*.{js,ts,svelte,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,svelte,css,html}\"",
    "sync-translations": "tsx scripts/sync-translations.ts"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^5.0.6",
    "@skeletonlabs/skeleton-svelte": "^5.0.6",
    "@sveltejs/adapter-vercel": "^7.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "googleapis": "^190.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "dependencies": {
    "@lucide/svelte": "^1.77.0",
    "@sjsf/ajv8-validator": "^3.10.0",
    "@sjsf/form": "^3.10.0",
    "@sjsf/skeleton5-theme": "^3.10.0",
    "@vercel/analytics": "^2.0.1",
    "ajv": "^8.20.0"
  }
}
